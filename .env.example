SUI_PRIVATE_KEY=<YOUR SUI CLIENT PRIVATE KEY started with suiprivkey>
EVM_PRIVATE_KEY=<YOUR EVM PRIVATE KEY>

# Optional: override the Sui fullnode RPC. If unset, falls back to the public
# Sui Foundation endpoints (getFullnodeUrl('testnet' | 'mainnet')). The public
# endpoints are aggressively rate-limited and periodically 404 on suix_*
# methods, so a private RPC is recommended.
SUI_TESTNET_RPC_URL=<YOUR SUI TESTNET RPC URL, e.g. https://rpcs.cldev.sh/sui/testnet>
SUI_MAINNET_RPC_URL=<YOUR SUI MAINNET RPC URL>
ETHEREUM_SEPOLIA_RPC_URL=<YOUR ETHEREUM SEPOLIA RPC URL>
ARBITRUM_SEPOLIA_RPC_URL=<YOUR ARBITRUM SEPOLIA RPC URL>
BASE_SEPOLIA_RPC_URL=<YOUR BASE SEPOLIA RPC URL>
BNB_CHAIN_TESTNET_RPC_URL=<YOUR BNB CHAIN TESTNET RPC URL>
OP_SEPOLIA_RPC_URL=<YOUR OP SEPOLIA RPC URL>
POLYGON_AMOY_RPC_URL=<YOUR POLYGON AMOY RPC URL>    
JOVAY_SEPOLIA_RPC_URL=<YOUR JOVAY SEPOLIA RPC URL>
AVALANCHE_FUJI_RPC_URL=<YOUR AVALANCHE FUJI RPC URL>
INK_SEPOLIA_RPC_URL=<YOUR INK SEPOLIA RPC URL>
PLASMA_TESTNET_RPC_URL=<YOUR PLASMA TESTNET RPC URL>
AVALANCHE_MAINNET_RPC_URL=<YOUR AVALANCHE MAINNET RPC URL>